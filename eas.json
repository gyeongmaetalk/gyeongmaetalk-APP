{
  "cli": {
    "version": ">= 15.0.12",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "env": {
        "ENV": "production",
        "GOOGLE_SERVICES_JSON": "./google-services.json",
        "GOOGLE_SERVICES_PLIST": "./GoogleService-Info.plist"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "latest",
        "simulator": false
      }
    },
    "preview": {
      "channel": "production",
      "distribution": "store",
      "env": {
        "ENV": "preview",
        "GOOGLE_SERVICES_JSON": "./google-services.json",
        "GOOGLE_SERVICES_PLIST": "./GoogleService-Info.plist"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "ENV": "development",
        "GOOGLE_SERVICES_JSON": "./google-services.json",
        "GOOGLE_SERVICES_PLIST": "./GoogleService-Info.plist"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json"
      },
      "ios": {
        "appleId": "bobplace000@gmail.com",
        "ascAppId": "6754525400"
      }
    }
  }
}
